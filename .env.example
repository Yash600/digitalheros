# Postgres connection strings (Neon, Supabase, or local Postgres).
# DATABASE_URL: pooled connection (Neon's "-pooler" host) - used by the app at
#   runtime. Reserve DATABASE_URL for anything more than one-off local scripts.
# DIRECT_URL: direct/non-pooled connection (no "-pooler" in the host) - used
#   only by `prisma migrate`, which wants a single unpooled session.
# On Neon, both are shown on the same Connection Details screen.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/leadflow?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/leadflow?sslmode=require"

# Clerk (https://dashboard.clerk.com) - Configure > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Shared invite code required to self-promote to Admin at /admin/claim.
# This is a deliberately simple gate for a demo/evaluation project, not
# production-grade access control - see README for the reasoning.
ADMIN_INVITE_CODE="leadflow-admin-2026"
